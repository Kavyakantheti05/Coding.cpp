#include <bits/stdc++.h>
using namespace std;

int main() {
	 int t;
    cin >> t;
    while (t--) {
        int x;
        cin >> x;
        if (x < 4) 
            cout << "Mild" << endl;
        else if (x < 7) 
            cout << "Medium" << endl;
        else 
            cout << "Hot" << endl;
    }
    return 0;

}
