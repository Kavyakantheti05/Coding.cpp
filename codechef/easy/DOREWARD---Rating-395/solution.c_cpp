#include <bits/stdc++.h>
using namespace std;

int main() {
	int testcases, x;
    cin >> testcases;
    for (int t = 0; t < testcases; t++) {
        cin >> x;
        if (x <= 3)
            cout << "Bronze" << endl;
        else if (x <= 6)
            cout << "Silver" << endl;
        else
            cout << "Gold" << endl;
    }
    return 0;

}
